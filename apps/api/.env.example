# Copy to .env and fill in. Never commit .env.

# Database (docker compose -f infra/docker-compose.yml up -d)
# Runtime role (no superuser / no BYPASSRLS) — row-level security applies.
DATABASE_URL=postgresql+psycopg://scholr_app:scholr_app_dev_password@localhost:5433/scholr
# Owner role — migrations only.
MIGRATION_DATABASE_URL=postgresql+psycopg://scholr:scholr_dev_password@localhost:5433/scholr
TEST_DATABASE_URL=postgresql+psycopg://scholr_app:scholr_app_dev_password@localhost:5433/scholr_test
TEST_MIGRATION_DATABASE_URL=postgresql+psycopg://scholr:scholr_dev_password@localhost:5433/scholr_test

# Environment: dev | test | prod
APP_ENV=dev

# Auth. In dev, locally signed tokens (HS256) are accepted. In prod, a managed provider's JWKS is required.
AUTH_MODE=dev
AUTH_DEV_SECRET=change-me-dev-only-secret-at-least-32-chars
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=

# LLM access via OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Private learning materials (gitignored)
SUBJECTS_DIR=../../subjects
PRIVATE_CONTENT_DIR=../../content/private
