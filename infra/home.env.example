# Copy to infra/home.env and fill in. Never commit the filled-in file (it is gitignored).
# Passwords: use long random strings, e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`.

SCHOLR_DB_PASSWORD=            # owner role, used by migrations
SCHOLR_APP_PASSWORD=           # scholr_app role, used by the API (row-level security applies to it)
SCHOLR_SESSION_SECRET=         # signs sign-in sessions; at least 32 characters
OPENROUTER_API_KEY=            # the only outside service Scholr calls
